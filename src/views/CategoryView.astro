---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CategoryTree from "@/components/CategoryTree.astro";
import ContactBand from "@/components/ContactBand.astro";
import ProductCard from "@/components/ProductCard.astro";
import { ancestry, plural, stockedChildren, type Category } from "@/lib/catalog";
import { enquiryMailto } from "@/lib/enquiry";
import { breadcrumbList } from "@/lib/schema";
import { BUSINESS, SITE_URL, TEL_HREF } from "@/consts";
import recycleHubBanner from "@/assets/home/recycle-hub-banner.jpg";
import skipParts from "@/assets/home/skip-parts.png";

interface Props {
  category: Category;
}

const { category } = Astro.props;
const chain = ancestry(category);
const department = chain[0];
const subcategories = stockedChildren(category);
const products = category.products;

/** Optional picture under a category's heading. */
const BANNERS: Record<string, { src: ImageMetadata; alt: string }> = {
  "recycle-hub": { src: recycleHubBanner, alt: "Litter bins and recycling stations in use" },
  "skip-parts-and-services": { src: skipParts, alt: "Skip rollers, hinges, lugs and other skip parts" },
};
const banner = BANNERS[category.id];

const description =
  category.description ??
  (products.length
    ? `${category.title} from Dusty Bins: ${plural(products.length, "product")} to choose from. Ask us for a quote.`
    : `${category.title} from Dusty Bins. Get in touch and we'll help you find the right bin.`);

const trail = [{ name: "Home", href: "/" }, ...chain.map((c) => ({ name: c.title, href: c.href }))];

const itemList = {
  "@type": "ItemList",
  name: category.title,
  itemListElement: products.map((product, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(product.href, SITE_URL).href,
    name: product.name,
  })),
};

// The department's tree for the sidebar, opened along the path to this page.
const open = new Set(chain.map((c) => c.id));
const showTree = stockedChildren(department).length > 0;
---

<BaseLayout title={category.title} description={description} schema={[breadcrumbList(trail), itemList]}>
  <div class="border-b border-stone-200 bg-brand-50">
    <div class="wrap py-10">
      <Breadcrumbs trail={trail} />
      <h1 class="display mt-4 text-4xl sm:text-5xl">{category.title}</h1>
      <p class="mt-3 max-w-2xl text-lg text-stone-600">{description}</p>
      {
        subcategories.length > 0 && (
          <nav aria-label={`Types of ${category.title.toLowerCase()}`} class="mt-6 flex flex-wrap gap-2">
            {subcategories.map((sub) => (
              <a
                href={sub.href}
                class="inline-flex items-center gap-1.5 rounded-full border border-stone-300 bg-white px-3.5 py-1.5 text-sm font-semibold text-ink hover:border-ink"
              >
                {sub.title}
                <span class="font-normal text-stone-400">{sub.products.length}</span>
              </a>
            ))}
          </nav>
        )
      }
    </div>
  </div>

  {
    banner && (
      <div class="wrap mt-8">
        <Image
          src={banner.src}
          alt={banner.alt}
          widths={[640, 960, 1280, banner.src.width]}
          sizes="(min-width: 1280px) 1216px, 100vw"
          class="mx-auto max-h-80 w-auto rounded-2xl"
          loading="eager"
        />
      </div>
    )
  }

  <div class:list={["wrap mt-10 grid gap-10", showTree && "lg:grid-cols-[15rem_1fr]"]}>
    <aside class:list={["hidden", showTree && "lg:block"]}>
      <h2 class="eyebrow text-stone-500">
        <a href={department.href} class="hover:text-ink">{department.title}</a>
      </h2>
      <CategoryTree nodes={department.children} current={category.id} open={open} />
    </aside>

    <div>
      {
        products.length > 0 ? (
          <>
            <p class="text-sm text-stone-500">{plural(products.length, "product")}</p>
            <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 xl:grid-cols-4">
              {products.map((product, i) => (
                <ProductCard product={product} loading={i < 4 ? "eager" : "lazy"} />
              ))}
            </div>
          </>
        ) : (
          <div class="rounded-2xl border border-dashed border-stone-300 p-8 sm:p-12">
            <Icon name="lucide:package-search" class="size-10 text-brand-600" />
            <h2 class="display mt-4 text-2xl">Coming soon</h2>
            <p class="mt-2 max-w-xl text-stone-600">
              We're still adding {category.title.toLowerCase()} to the website, but we can supply them now. Give us a
              call or send us an email and tell us what you need.
            </p>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
              <a href={TEL_HREF} class="btn btn-primary">
                <Icon name="lucide:phone" class="size-5" />
                {BUSINESS.telephoneDisplay}
              </a>
              <a href={enquiryMailto({ name: category.title })} class="btn btn-outline">
                <Icon name="lucide:mail" class="size-5" />
                Email an enquiry
              </a>
            </div>
          </div>
        )
      }

      {
        chain.length > 1 && (
          <p class="mt-10">
            <a href={chain.at(-2)!.href} class="inline-flex items-center gap-1 font-semibold text-brand-700 hover:underline">
              <Icon name="lucide:arrow-left" class="size-4" />
              All {chain.at(-2)!.title.toLowerCase()}
            </a>
          </p>
        )
      }
    </div>
  </div>

  <ContactBand />
</BaseLayout>
