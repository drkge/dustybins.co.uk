---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { breadcrumbList } from "@/lib/schema";
import { BUSINESS, MAILTO_HREF, TEL_HREF } from "@/consts";

const trail = [
  { name: "Home", href: "/" },
  { name: "Contact", href: "/contact/" },
];

const directions =
  "https://www.google.com/maps/dir/?api=1&destination=" +
  encodeURIComponent(`${BUSINESS.address.street}, ${BUSINESS.address.locality}, ${BUSINESS.address.postalCode}`);
---

<BaseLayout
  title="Contact us"
  description={`Call ${BUSINESS.telephoneDisplay} or email ${BUSINESS.email} for a quote on recycling bins, litter bins and wheelie bins.`}
  schema={[breadcrumbList(trail)]}
>
  <div class="border-b border-stone-200 bg-stone-50">
    <div class="wrap py-10">
      <Breadcrumbs trail={trail} />
      <h1 class="display mt-4 text-4xl sm:text-5xl">Get in touch</h1>
      <p class="mt-3 max-w-2xl text-lg text-stone-600">
        For a quote, trade rates or help choosing the right bin, give us a call or send us an email. Tell us which bins,
        how many, any colours or extras, and your delivery postcode, and we'll come back to you.
      </p>
    </div>
  </div>

  <div class="wrap mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    <a href={TEL_HREF} class="group rounded-2xl bg-ink p-8 text-white">
      <Icon name="lucide:phone" class="size-8 text-brand-400" />
      <p class="mt-6 text-sm text-stone-400">Phone</p>
      <p class="display mt-1 text-3xl group-hover:text-brand-300">{BUSINESS.telephoneDisplay}</p>
    </a>
    <a href={MAILTO_HREF} class="group rounded-2xl border border-stone-200 p-8 hover:border-ink">
      <Icon name="lucide:mail" class="size-8 text-brand-700" />
      <p class="mt-6 text-sm text-stone-500">Email</p>
      <p class="mt-1 text-xl font-semibold break-all text-ink group-hover:text-brand-700">{BUSINESS.email}</p>
    </a>
    <div class="rounded-2xl border border-stone-200 p-8 md:col-span-2 lg:col-span-1">
      <Icon name="lucide:map-pin" class="size-8 text-brand-700" />
      <p class="mt-6 text-sm text-stone-500">Address</p>
      <address class="mt-1 text-ink not-italic">
        {BUSINESS.addressLines.map((line) => <span class="block">{line}</span>)}
      </address>
      <a href={directions} class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:underline">
        Get directions
        <Icon name="lucide:arrow-up-right" class="size-4" />
      </a>
    </div>
  </div>

  <div class="wrap mt-10">
    <p class="max-w-2xl text-stone-600">
      Looking at a particular bin? The <strong class="text-ink">Enquire</strong> button on each product page starts
      an email with the bin, your chosen options and quantity already filled in.
    </p>
  </div>
</BaseLayout>
