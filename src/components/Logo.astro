---
import { Image } from "astro:assets";
import logo from "@/assets/logo.png";

interface Props {
  class?: string;
}

const { class: className = "size-16" } = Astro.props;
---

<a href="/" class="inline-flex shrink-0 items-center" aria-label="Dusty Bins home">
  <Image src={logo} alt="Dusty Bins" class={className} widths={[80, 160, 240]} sizes="80px" loading="eager" />
</a>
