---
import { Icon } from "astro-icon/components";
import ProductImage from "./ProductImage.astro";
import { shortCapacity, swatches, type Product } from "@/lib/catalog";
import { enquiryMailto } from "@/lib/enquiry";

interface Props {
  product: Product;
  loading?: "eager" | "lazy";
}

const { product, loading } = Astro.props;
const colours = swatches(product);
const MAX_SWATCHES = 7;
const capacity = shortCapacity(product);
---

<article
  class="group relative flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white transition hover:border-stone-400 hover:shadow-lg hover:shadow-stone-900/5"
  data-product
>
  <ProductImage
    image={product.photos[0]}
    alt={product.name}
    sizes="(min-width: 1280px) 280px, (min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
    loading={loading}
    class="border-b border-stone-100"
  />
  <div class="flex flex-1 flex-col p-4">
    {(product.code || capacity) && <p class="code truncate">{[capacity, product.code].filter(Boolean).join(" · ")}</p>}
    <h3 class="mt-1 text-[0.95rem] leading-snug font-semibold">
      <a href={product.href} class="after:absolute after:inset-0 hover:text-brand-700">
        {product.name}
      </a>
    </h3>
    {
      colours.length > 1 && (
        <p class="mt-2.5 flex items-center gap-1" aria-label={`${colours.length} colours`}>
          {colours.slice(0, MAX_SWATCHES).map((colour) => (
            <span
              class="size-3.5 rounded-full ring-1 ring-stone-900/15 ring-inset"
              style={`background: ${colour.colour}`}
              title={colour.name}
            />
          ))}
          {colours.length > MAX_SWATCHES && (
            <span class="ml-0.5 text-xs text-stone-500">+{colours.length - MAX_SWATCHES}</span>
          )}
        </p>
      )
    }
    <div class="mt-auto pt-4">
      <a
        href={enquiryMailto(product)}
        class="btn btn-sm btn-outline relative z-10 w-full group-hover:border-brand-700 group-hover:text-brand-700"
        aria-label={`Enquire about ${product.name}`}
      >
        <Icon name="lucide:mail" class="size-4" />
        Enquire
      </a>
    </div>
  </div>
</article>
