---
import { Icon } from "astro-icon/components";
import { getDepartments, stockedChildren } from "@/lib/catalog";
import { BUSINESS, TEL_HREF, MAILTO_HREF } from "@/consts";

// Skip parts has no sub-categories, so it's listed under "More" instead.
const departments = (await getDepartments()).filter((department) => stockedChildren(department).length > 0);
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t-4 border-brand-400 bg-ink text-stone-300">
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <p class="display text-2xl text-white">Dusty Bins</p>
      <p class="mt-3 max-w-sm">
        Recycling bins, litter bins and steel and plastic wheelie bins from Coatbridge. Get in touch for a quote.
      </p>
      <ul class="mt-6 space-y-3">
        <li>
          <a href={TEL_HREF} class="inline-flex items-center gap-3 font-semibold text-white hover:text-brand-300">
            <Icon name="lucide:phone" class="size-5 text-brand-400" />
            {BUSINESS.telephoneDisplay}
          </a>
        </li>
        <li>
          <a href={MAILTO_HREF} class="inline-flex items-center gap-3 break-all hover:text-white">
            <Icon name="lucide:mail" class="size-5 shrink-0 text-brand-400" />
            {BUSINESS.email}
          </a>
        </li>
        <li class="flex gap-3">
          <Icon name="lucide:map-pin" class="mt-0.5 size-5 shrink-0 text-brand-400" />
          <span>{BUSINESS.addressLines.join(", ")}</span>
        </li>
      </ul>
    </div>

    {
      departments.map((department) => (
        <div>
          <h2 class="eyebrow text-stone-400">
            <a href={department.href} class="hover:text-white">
              {department.title}
            </a>
          </h2>
          <ul class="mt-4 space-y-2 text-sm">
            {stockedChildren(department).map((category) => (
              <li>
                <a href={category.href} class="hover:text-white">
                  {category.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-3 py-6 text-sm text-stone-400 md:flex-row md:items-center md:justify-between">
      <p>© {year} {BUSINESS.legalName}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li><a href="/all-products/" class="hover:text-white">All products</a></li>
        <li><a href="/skip-parts-and-services/" class="hover:text-white">Skip parts</a></li>
        <li><a href="/contact/" class="hover:text-white">Contact</a></li>
        <li><a href="/privacy/" class="hover:text-white">Privacy</a></li>
      </ul>
    </div>
  </div>
</footer>
