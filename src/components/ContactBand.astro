---
import { Icon } from "astro-icon/components";
import { BUSINESS, TEL_HREF, MAILTO_HREF } from "@/consts";

interface Props {
  title?: string;
}

const { title = "Can't see the bin you need?" } = Astro.props;
---

<section class="wrap mt-20">
  <div class="relative overflow-hidden rounded-2xl bg-brand-400 px-6 py-10 sm:px-12 sm:py-12">
    <div class="relative flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-xl">
        <h2 class="display text-3xl sm:text-4xl">{title}</h2>
        <p class="mt-3 text-lg text-ink/80">
          We supply far more than we list, including bulk orders, custom colours and branded signage. Tell us what
          you're after and we'll come back with a quote.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={TEL_HREF} class="btn btn-dark">
          <Icon name="lucide:phone" class="size-5" />
          {BUSINESS.telephoneDisplay}
        </a>
        <a href={MAILTO_HREF} class="btn border border-ink/20 bg-white text-ink hover:border-ink">
          <Icon name="lucide:mail" class="size-5" />
          Email us
        </a>
      </div>
    </div>
  </div>
</section>
